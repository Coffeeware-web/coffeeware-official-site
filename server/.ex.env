# Copia questo file in ".env" e compila i valori.

NODE_ENV=dev
PORT=3001

# Origin del sito ammessi per il CORS (separati da virgola).
# Es. sviluppo + produzione:
ALLOWED_ORIGIN=http://localhost:5173,https://www.coffeewaredesigns.com

# Cloudflare Turnstile — secret key (lato server). Se vuota, in dev la verifica è saltata.
TURNSTILE_SECRET_KEY=

# Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Coffeeware <noreply@coffeewaredesigns.com>
CONTACT_TO_EMAIL=info@coffeewaredesigns.com
