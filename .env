# Copia questo file in ".env" e compila i valori.

# Base URL del backend (server/). In dev: http://localhost:3001
VITE_API_BASE_URL=coffeeware-react.onrender.com

# Cloudflare Turnstile — site key (pubblica, lato client).
# Se vuota, il form invia senza token e il server (senza secret) salta la verifica.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAD9AnzGUMPnK81p4
